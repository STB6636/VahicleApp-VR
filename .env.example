# =============================================================================
# Vehicle App (ระบบต่อภาษีและใบอนุญาตยานพาหนะราชการ) — Environment Template
# คัดลอกไฟล์นี้เป็น .env.local สำหรับรันในเครื่อง (ห้าม commit .env.local ขึ้น Git)
# =============================================================================

# Supabase Project เดียวกับ Portal SSO-VR แต่แยก Schema เป็น vehicleapp
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>
VITE_SUPABASE_SCHEMA=vehicleapp

# Portal SSO-VR Integration (Mode B SPA + Strict Portal-Only Entry)
VITE_PORTAL_API_URL=https://<your-project-ref>.supabase.co/functions/v1/portal-api
VITE_PORTAL_URL=https://<your-portal-sso-url>
VITE_APP_CODE=VEHICLE_APP

# Dual-Hosting Router Mode:
#   Cloudflare Pages -> VITE_ROUTER_MODE=browser, VITE_BASE_PATH=/
#   GitHub Pages     -> VITE_ROUTER_MODE=hash,    VITE_BASE_PATH=/VahicleApp-VR/
VITE_ROUTER_MODE=hash
VITE_BASE_PATH=./
